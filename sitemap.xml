---
layout: none
permalink: /sitemap.xml
---
{%- comment -%}
  Built from the pages themselves, so a new page is listed the moment it
  exists. Left out: any page with `sitemap: false` or `noindex: true` in
  its front matter (the 404 page), and anything that is not an HTML page.
  URLs are the clean form the site links to: no .html, no trailing slash.
  lastmod is the page's `updated` or `date` where it has one, otherwise
  the build date.
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign _pages = site.pages | sort: "url" -%}
{%- for _p in _pages -%}
  {%- unless _p.url contains ".html" or _p.url == "/" -%}{%- continue -%}{%- endunless -%}
  {%- if _p.sitemap == false or _p.noindex -%}{%- continue -%}{%- endif -%}
  {%- assign _u = _p.url | remove: ".html" -%}
  {%- if _u == "/index" -%}{%- assign _u = "/" -%}{%- endif -%}
  {%- assign _mod = _p.updated | default: _p.date | default: site.time -%}
  <url>
    <loc>https://www.fixmypcperth.com{{ _u }}</loc>
    <lastmod>{{ _mod | date: "%Y-%m-%d" }}</lastmod>
  </url>
{%- endfor %}
</urlset>
